      "id": "ms-013",
      "text": "Você acabou de subir de nível.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-014",
      "text": "Nada pra dizer. Só orgulho.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-015",
      "text": "Marca essa data. Você venceu hoje.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-016",
      "text": "Sua constância virou identidade.",
      "category": "milestone",
      "weight": 1.5
    },
    {
      "id": "ms-017",
      "text": "Isso é o que separa quem passa de quem tenta.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-018",
      "text": "Vem cá receber um abraço de sapo.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-019",
      "text": "Sequência de gente séria.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-020",
      "text": "Você acabou de bater sua melhor marca.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-021",
      "text": "Sabe que isso é raro, né? Poucos chegam aqui.",
      "category": "milestone",
      "weight": 1.5
    },
    {
      "id": "ms-022",
      "text": "Bora comemorar com mais um Pomodoro amanhã.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-023",
      "text": "Um marco importante ficou pra trás.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-024",
      "text": "Você tá indo além do combinado.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "ms-025",
      "text": "Isso aqui é rotina de vestibulando forte.",
      "category": "milestone",
      "weight": 1.0
    },
    {
      "id": "sr-001",
      "text": "Sua hora chegou. Bora?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-002",
      "text": "Combinamos agora, lembra?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-003",
      "text": "Tá na hora do foco 🎯",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-004",
      "text": "Vinte e cinco minutinhos, tá reservado.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-005",
      "text": "Sua rotina tá te chamando.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-006",
      "text": "Hora combinada, foco garantido.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-007",
      "text": "Bora honrar o compromisso com você?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-008",
      "text": "Sua rotina é sua palavra.",
      "category": "sessionReminder",
      "weight": 1.5
    },
    {
      "id": "sr-009",
      "text": "Chegou a hora do foco de hoje.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-010",
      "text": "Tá na agenda. Bora cumprir?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-011",
      "text": "Você marcou esse horário. Não fura.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-012",
      "text": "É agora. Sem enrolação.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-013",
      "text": "O foco combinado te espera.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-014",
      "text": "Hora nobre, foco nobre.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-015",
      "text": "Combinei com você. Cumpre?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-016",
      "text": "Vem, começa. Depois eu te libero.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-017",
      "text": "Rotina é acordo com o futuro.",
      "category": "sessionReminder",
      "weight": 1.5
    },
    {
      "id": "sr-018",
      "text": "Sua meta tá esperando esse Pomodoro.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-019",
      "text": "Bora fazer o que combinamos ontem?",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-020",
      "text": "Momento marcado. Momento cumprido.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-021",
      "text": "Chegou a hora. Sem rodeios.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-022",
      "text": "Foco no horário certo rende dobrado.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-023",
      "text": "Você agendou. Agora só executar.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "sr-024",
      "text": "Sua palavra vale mais que sua vontade.",
      "category": "sessionReminder",
      "weight": 1.5
    },
    {
      "id": "sr-025",
      "text": "Combinou. Tá na hora.",
      "category": "sessionReminder",
      "weight": 1.0
    },
    {
      "id": "gm-001",
      "text": "Um foco por dia, uma vitória por dia.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-002",
      "text": "Constância vence talento cansado.",
      "category": "generic",
      "weight": 1.5
    },
    {
      "id": "gm-003",
      "text": "Você é o que faz todos os dias.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-004",
      "text": "Estudo é conversa longa com o futuro.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-005",
      "text": "Cada Pomodoro te aproxima da vaga.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-006",
      "text": "Não precisa ser rápido. Precisa ser constante.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-007",
      "text": "O foco de hoje decide o resultado de amanhã.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-008",
      "text": "Ninguém vê o processo. Todo mundo vê o resultado.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-009",
      "text": "Não conta pra ninguém. Só faz.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-010",
      "text": "Rotina chata é rotina que funciona.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-011",
      "text": "Você não tá atrasado. Tá no seu ritmo.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-012",
      "text": "Estuda com calma. O tempo é seu.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-013",
      "text": "Um dia bom já é motivo pra mais um.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-014",
      "text": "Foco não é o que você sente. É o que você faz.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-015",
      "text": "A vaga vai pra quem estudou hoje.",
      "category": "generic",
      "weight": 1.5
    },
    {
      "id": "gm-016",
      "text": "Nada substitui as horas com a matéria.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-017",
      "text": "Vestibular se ganha em janeiro. Se prepara em julho.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-018",
      "text": "Cada minuto conta. Até esse.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-019",
      "text": "Você tá mais perto do que ontem.",
      "category": "generic",
      "weight": 1.5
    },
    {
      "id": "gm-020",
      "text": "Estudar é o hábito mais gentil que você pode ter.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-021",
      "text": "Um Pomodoro é uma promessa cumprida.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-022",
      "text": "A vitória mora na sequência.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-023",
      "text": "Sem drama. Só ação.",
      "category": "generic",
      "weight": 1.0
    },
    {
      "id": "gm-024",
      "text": "O sapo acredita em você. Faltou você acreditar.",
      "category": "generic",
      "weight": 1.5
    },
    {
      "id": "gm-025",
      "text": "Você tem hoje. Usa bem.",
      "category": "generic",
      "weight": 1.0
    }
  ]
}
